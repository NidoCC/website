---
import TopButton from "@components/TopButton.astro";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { getCollection } from "astro:content";
import { MoveLeft } from "@lucide/astro";

export async function getStaticPaths() {
  const posts = await getCollection("post");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`<NidoCC.Post name="${post.data.title}" />`}>
  <TopButton />

  <div class="flex justify-center">
    <article class="w-[70ch] bg-secondary mt-32">
      <div class="relative">
        <Image
          src={post.data.thumbnail}
          alt={post.data.title}
          width={500}
          height={300}
          class="w-full max-h-96"
        />
        <div
          class="pointer-events-none absolute inset-x-0 left-0 bottom-0 w-full h-20 bg-linear-to-t from-secondary via-secondary/70 to-transparent"
        >
        </div>
      </div>
      <a
        href="/post"
        class="font-mono uppercase pl-4 mt-4 hover:text-muted-foreground"
        ><MoveLeft class="inline" /> Go back</a
      >
      <div class="p-4">
        <p class="text-muted-foreground font-mono uppercase">Title</p>
        <h1 class="text-4xl">{post.data.title}</h1>
        <p class="text-muted-foreground font-mono uppercase mt-4">
          Description
        </p>
        <p class="break-before-all text-justify">{post.data.description}</p>
        <div class="flex justify-between items-start mt-4">
          <span>
            <p class="text-muted-foreground font-mono uppercase">Author(s)</p>
            <ul>{post.data.authors.map((author) => <li>{author}</li>)}</ul>
          </span>
          <span>
            <p class="text-muted-foreground font-mono uppercase">Uploaded</p>
            <p>{post.data.uploaded.toLocaleDateString()}</p>
          </span>
          <span>
            <p class="text-muted-foreground font-mono uppercase">
              Last Updated
            </p>
            <p>{post.data.lastUpdated.toLocaleDateString()}</p>
          </span>
          <span>
            <p class="text-muted-foreground font-mono uppercase">Tags</p>
            <ul>
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </span>
        </div>
        <hr class="my-8" />
        <div class="prose prose-invert text-justify">
          <Content />
        </div>
      </div>
    </article>
  </div>
</Layout>
