---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"post">;
}

const { post } = Astro.props;
---

<a
  href={`/post/${post.id}`}
  class="bg-secondary hover:brightness-125 flex h-72 w-[70ch] overflow-hidden"
>
  <div class="min-w-0 flex-1 p-5">
    <h3 class="font-mono text-2xl wrap-break-word">{post.data.title}</h3>
    <p
      class="mt-2 overflow-hidden text-muted-foreground break-before-all"
      style="display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4;"
    >
      {post.data.description}
    </p>
  </div>
  <div class="relative h-full w-60 shrink-0">
    <Image
      src={post.data.thumbnail}
      alt={post.data.title}
      width={400}
      height={400}
      class="h-full w-full object-cover"
    />
    <div
      class="pointer-events-none absolute inset-y-0 left-0 w-20 bg-linear-to-r from-secondary via-secondary/70 to-transparent"
    >
    </div>
  </div>
</a>
