---
import { QRCode } from "$lib/components/spell/qrcode";

const layers = Array.from({ length: 10 }, (_, i) => i);
const linkUrl =
  "https://docs.google.com/forms/d/e/1FAIpQLSdjRvvvxS-Ed3zshhSqeWVHB8ELzm-PALgskc29ojHyK03M-w/viewform?usp=dialog";
---

<section class="grid place-items-center" id="join">
  <div class="relative">
    <h1 class="font-mono text-4xl text-center mb-6">
      Want to <span class="text-emerald-400">join?</span>
    </h1>
    <p class="text-muted-foreground text-center">
      Scan or click the QR code. <br />
    </p>
    <p class="text-muted-foreground mb-6 text-center text-xs">
      We're still accepting new members!!!
    </p>

    <div class="relative block mt-2 mx-auto" style="width:400px; height:400px;">
      {
        // left-side layers (mirrored)
        layers
          .slice(1)
          .reverse()
          .map((i) => (
            <div
              class="absolute top-0 left-0 h-full w-full flex justify-center items-center"
              style={`
              transform: translateX(${-i * 20}px) translateY(${i * 8}px) scale(${1 - i * 0.02});
              opacity: ${Math.max(0, 1 - i / layers.length)};
              z-index: ${layers.length - i};
              filter: blur(${i * 0.1}px) saturate(${1 - i * 0.05});
              pointer-events: none;
            `}
            >
              <div class="block w-full h-full">
                <div class="flex justify-center items-center flex-col px-6 py-4 rounded-xl border-emerald-900 border-2 bg-neutral-900 w-full h-full">
                  <QRCode
                    value={linkUrl}
                    fgColor="#00d492"
                    bgColor="#171717"
                    width={400}
                    height={400}
                  />
                </div>
              </div>
            </div>
          ))
      }

      {
        // right-side layers including the interactive top card
        layers.map((i) => (
          <div
            class="absolute top-0 left-0 w-full h-full flex items-center justify-center"
            style={`
            transform: translateX(${i * 20}px) translateY(${i * 8}px) scale(${1 - i * 0.02});
            opacity: ${Math.max(0, 1 - i / layers.length)};
            z-index: ${layers.length - i};
            filter: blur(${i * 0.1}px) saturate(${1 - i * 0.05});
            pointer-events: ${i === 0 ? "auto" : "none"};
          `}
          >
            {i === 0 ? (
              <a
                href={linkUrl}
                target="_blank"
                rel="noreferrer"
                class="block w-full h-full"
                aria-label={linkUrl}
              >
                <div class="flex justify-center items-center flex-col px-6 py-4 rounded-xl border-emerald-900 border-2 bg-neutral-900 w-full h-full">
                  <QRCode
                    value={linkUrl}
                    fgColor="#00d492"
                    bgColor="#171717"
                    width={400}
                    height={400}
                  />
                </div>
              </a>
            ) : (
              <div class="block w-full h-full">
                <div class="flex justify-center items-center flex-col px-6 py-4 rounded-xl border-emerald-900 border-2 bg-neutral-900 w-full h-full">
                  <QRCode
                    value={linkUrl}
                    fgColor="#00d492"
                    bgColor="#171717"
                    width={400}
                    height={400}
                  />
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
